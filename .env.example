# Database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kmind
# For Next.js to connect to postgres in Docker:
DATABASE_URL=postgresql://postgres:postgres@db:5432/kmind?schema=public
# For Next.js to connect to postgres locally (outside Docker):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kmind?schema=public

# Redis configuration
REDIS_URL=redis://redis:6379
# For Next.js to connect to redis locally (outside Docker):
# REDIS_URL=redis://localhost:6379

# AI Copilot configuration (Add your api key)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash
